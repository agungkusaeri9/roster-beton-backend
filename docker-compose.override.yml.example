# Example override file for local development
# Copy this file to docker-compose.override.yml and customize as needed
# docker-compose.override.yml is automatically loaded by docker-compose

version: '3.8'

services:
  app:
    environment:
      GIN_MODE: debug
    volumes:
      - .:/app
      - /app/vendor
    command: >
      sh -c "
        go mod download &&
        go run cmd/main.go
      "

