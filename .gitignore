# ==============================
# 🌱 Go Build & Dependencies
# ==============================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of the go build command
/build/
bin/
dist/
tmp/
*.out

# Go workspace
go.work
go.work.sum

# Dependency directories (for vendoring)
vendor/

# ==============================
# ⚙️ Environment & Config Files
# ==============================

# Local environment variables
.env
.env.local
.env.dev
.env.prod
.env.staging

# App-specific config
config.yaml
config.yml
settings.json

# ==============================
# 🗃️ Database & Migrations
# ==============================

# Migration logs / temp files
migrations/*.tmp
migrations/*.log

# SQLite or test databases
*.db
*.sqlite
*.sqlite3

# ==============================
# 🧪 Tests & Coverage
# ==============================

# Test binary, coverage, logs
*.cover
*.coverprofile
coverage.out
coverage.html
test-results/
.idea/testResults/

# ==============================
# 💾 IDE & Editor files
# ==============================

# VSCode
.vscode/
*.code-workspace

# JetBrains (GoLand)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*~
.*.swp
.*.swo

# ==============================
# 🐳 Docker & Containers
# ==============================

# Docker stuff
docker-compose.override.yml
.docker/
.dockerignore

# Container data (mounted volumes)
postgres_data/
redis_data/

# ==============================
# 🧰 Miscellaneous
# ==============================

# Logs
*.log
log/
logs/

# Temporary / cache files
*.tmp
*.bak
*.old
.DS_Store
Thumbs.db

# ==============================
# 🔥 Build Artifacts (Optional)
# ==============================

# If you build releases manually
*.zip
*.tar.gz
*.tar
