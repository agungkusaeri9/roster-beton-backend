# ==============================
# 🌱 Go Build & Dependencies
# ==============================

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of the go build command
/build/
bin/
dist/
tmp/
*.out

# Go workspace
go.work
go.work.sum

# Dependency directories (for vendoring)
vendor/

# ==============================
# ⚙️ Environment & Config Files
# ==============================

# Local environment variables (SENSITIVE - DO NOT COMMIT)
.env
.env.*
!.env.example
.env.local
.env.dev
.env.development
.env.prod
.env.production
.env.staging
.env.test
.env.backup
.env.old
*.env

# App-specific config (if contains sensitive data)
config.yaml
config.yml
settings.json
appsettings.json
appsettings.*.json
!appsettings.example.json

# Secrets and credentials (SENSITIVE - DO NOT COMMIT)
*secret*
*secrets*
*key*
*keys*
*credential*
*credentials*
*password*
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.private
*.pub
private_key*
public_key*

# ==============================
# 🗃️ Database & Migrations
# ==============================

# Migration logs / temp files
migrations/*.tmp
migrations/*.log

# SQLite or test databases
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Database dumps and backups (may contain sensitive data)
*.sql
*.dump
*.backup
!migrations/*.sql

# ==============================
# 🧪 Tests & Coverage
# ==============================

# Test binary, coverage, logs
*.cover
*.coverprofile
coverage.out
coverage.html
test-results/
.idea/testResults/

# ==============================
# 💾 IDE & Editor files
# ==============================

# VSCode
.vscode/
*.code-workspace

# JetBrains (GoLand)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*~
.*.swp
.*.swo

# ==============================
# 🐳 Docker & Containers
# ==============================

# Docker stuff
docker-compose.override.yml
.docker/
.dockerignore

# Container data (mounted volumes)
postgres_data/
redis_data/

# ==============================
# 🔐 Security & Sensitive Files
# ==============================

# JWT tokens and session files
*.token
*.session
sessions/

# API keys and tokens
api_keys.txt
tokens.txt

# Backup files (may contain sensitive data)
*.backup
*.bak
*.old
*.orig
*~

# ==============================
# 🧰 Miscellaneous
# ==============================

# Logs (may contain sensitive information)
*.log
log/
logs/
*.log.*

# Temporary / cache files
*.tmp
*.cache
.cache/
tmp/
temp/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==============================
# 🔥 Build Artifacts (Optional)
# ==============================

# If you build releases manually
*.zip
*.tar.gz
*.tar
